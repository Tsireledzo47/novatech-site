<script>
let tickets = JSON.parse(localStorage.getItem('novaTickets')||'[]');
function show(id){
document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
document.getElementById(id).classList.add('active');
document.querySelectorAll('nav a').forEach(a=>a.classList.remove('active'));
event?.target?.classList?.add('active');
window.scrollTo(0,0);
if(id==='dashboard')updateDashboard();
}
function submitTicket(e){
e.preventDefault();
let t={id:'NT-'+(1000+tickets.length+1), name:document.getElementById('tName').value, email:document.getElementById('tEmail').value, cat:document.getElementById('tCat').value, urg:document.getElementById('tUrg').value, sub:document.getElementById('tSub').value, status:'Open'};
tickets.push(t);
localStorage.setItem('novaTickets',JSON.stringify(tickets));
document.getElementById('ticketMsg').innerText='Ticket '+t.id+' Logged Successfully!';
e.target.reset();
updateDashboard();
}
function updateDashboard(){
document.getElementById('statTotal').innerText=tickets.length;
document.getElementById('statOpen').innerText=tickets.filter(x=>x.status==='Open').length;
document.getElementById('statProg').innerText=tickets.filter(x=>x.status==='In Progress').length;
document.getElementById('statRes').innerText=tickets.filter(x=>x.status==='Resolved').length;
let table=document.getElementById('liveTable');
table.innerHTML='<tr><th>ID</th><th>Subject</th><th>Category</th><th>Urgency</th><th>Status</th><th>Action</th></tr>';
tickets.slice().reverse().forEach((t,i)=>{
let realIdx=tickets.length-1-i;
table.innerHTML+=`<tr><td>${t.id}</td><td>${t.sub}</td><td>${t.cat}</td><td>${t.urg}</td><td><span class="badge ${t.status==='Open'?'open':t.status==='In Progress'?'progress':'resolved'}">${t.status}</span></td><td><select onchange="changeStatus(${realIdx},this.value)"><option>Open</option><option>In Progress</option><option>Resolved</option></select></td></tr>`;
});
drawCharts();
}
function changeStatus(idx,val){tickets[idx].status=val;localStorage.setItem('novaTickets',JSON.stringify(tickets));updateDashboard();}
let barC,pieC;
function drawCharts(){
let cats={};tickets.forEach(t=>cats[t.cat]=(cats[t.cat]||0)+1);
let ctx1=document.getElementById('barChart'); if(barC)barC.destroy();
barC=new Chart(ctx1,{type:'bar',data:{labels:Object.keys(cats).length?Object.keys(cats):['No Data'],datasets:[{label:'Tickets by Category',data:Object.values(cats).length?Object.values(cats):[0],backgroundColor:'#1976d2'}]},options:{responsive:true,plugins:{title:{display:true,text:'Live Ticket Logging - Bar Graph'}}}});
let urg={Low:0,Medium:0,High:0,Critical:0};tickets.forEach(t=>{if(urg[t.urg]!==undefined)urg[t.urg]++});
let ctx2=document.getElementById('pieChart'); if(pieC)pieC.destroy();
pieC=new Chart(ctx2,{type:'doughnut',data:{labels:Object.keys(urg),datasets:[{data:Object.values(urg),backgroundColor:['#90caf9','#42a5f5','#ef5350','#b71c1c']}]},options:{plugins:{title:{display:true,text:'Tickets by Urgency'}}}});
}
function addAsset(){
let id=document.getElementById('aId').value, name=document.getElementById('aName').value, cat=document.getElementById('aCat').value, user=document.getElementById('aUser').value, val=parseFloat(document.getElementById('aVal').value)||0, stat=document.getElementById('aStat').value;
if(!id||!name)return alert('Fill Asset ID and Name');
let row=document.getElementById('assetTable').insertRow();
row.innerHTML=`<td>${id}</td><td>${name}</td><td>${cat}</td><td>${user}</td><td>${new Date().toISOString().split('T')[0]}</td><td>${val}</td><td>${stat}</td>`;
calcAssets();
}
function calcAssets(){
let rows=document.getElementById('assetTable').rows, total=0, active=0;
for(let i=1;i<rows.length;i++){total+=parseFloat(rows[i].cells[5].innerText)||0; if(rows[i].cells[6].innerText==='Active')active++;}
document.getElementById('assetTotal').innerText='R '+total.toLocaleString();
document.getElementById('assetCount').innerText=rows.length-1;
document.getElementById('assetActive').innerText=active;
}
calcAssets(); updateDashboard();
function toggleChat(){let b=document.getElementById('chatBox');b.style.display=b.style.display==='flex'?'none':'flex';}
const qa={
"reset my password":"To reset your password:\n1. Go to login screen\n2. Click Forgot Password\n3. Enter email/username\n4. Check email for reset link\n5. Create new strong password",
"restart my router":"To restart router:\n1. Unplug power cable\n2. Wait 30 seconds\n3. Plug back\n4. Wait lights stabilize\n5. Test internet",
"install software":"To install software:\n1. Download installer from official site\n2. Double-click installer\n3. Follow Next → Accept → Install\n4. Wait finish\n5. Launch from Start menu",
"connect to wifi":"To connect WiFi:\n1. Open WiFi settings\n2. Select network SSID\n3. Enter password\n4. Tap Connect\n5. Open browser to confirm",
"submit a ticket":"To submit ticket:\n1. Login helpdesk portal\n2. Click Submit New Ticket\n3. Fill issue type, description, urgency\n4. Attach screenshots\n5. Submit and note ticket number",
"update my software":"To update software:\n1. Open software\n2. Go Help/Settings\n3. Check for Updates\n4. Download and Install\n5. Restart software"
};
function sendChat(){
let input=document.getElementById('chatText');let q=input.value.toLowerCase(); if(!q)return;
let box=document.getElementById('chatMessages');
box.innerHTML+=`<div class="msg user">${input.value}</div>`;
let answer="Sorry, I didn't understand. Try asking: How can I reset my password? How do I restart my router? How do I install software? How do I connect to WiFi? How do I submit a ticket? How do I update my software?";
for(let k in qa){if(q.includes(k.split(' ')[0]) && q.includes(k.split(' ').pop()) || q.includes(k)){answer=qa[k];break;}}
// fuzzy match
if(q.includes('password'))answer=qa['reset my password'];
else if(q.includes('router'))answer=qa['restart my router'];
