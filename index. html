<style>
:root{--blue:#0f4c81;--blue2:#1976d2;--grey:#f4f6f9;--dark:#1e293b;--white:#fff}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Arial,sans-serif}
body{background:var(--grey);color:var(--dark)}
header{background:var(--blue);color:white;padding:15px 5%;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:1000}
.logo{font-weight:800;font-size:22px;letter-spacing:1px}
.logo span{color:#90caf9}
nav a{color:white;text-decoration:none;margin-left:18px;font-size:14px;padding:8px 12px;border-radius:20px;cursor:pointer}
nav a.active,nav a:hover{background:rgba(255,255,255,0.2)}
.hero{background:linear-gradient(120deg,var(--blue),var(--blue2));color:white;padding:60px 5%;text-align:center}
.hero h1{font-size:38px;margin-bottom:10px}
.hero p{max-width:800px;margin:10px auto;line-height:1.6;opacity:0.9}
.btn{background:var(--blue2);color:white;border:none;padding:12px 22px;border-radius:6px;cursor:pointer;font-weight:600}
.btn:hover{background:var(--blue)}
.section{display:none;padding:30px 5%;animation:fade.3s}
.section.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.card{background:white;border-radius:12px;padding:20px;box-shadow:0 4px 15px rgba(0,0,0,0.06);margin-bottom:20px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}
h2{color:var(--blue);margin-bottom:15px;border-left:4px solid var(--blue2);padding-left:10px}
h3{color:var(--blue);margin:15px 0 10px}
input,select,textarea{width:100%;padding:11px;border:1px solid #d1d5db;border-radius:6px;margin:6px 0 12px}
label{font-weight:600;font-size:13px}
table{width:100%;border-collapse:collapse;margin-top:10px}
th,td{border:1px solid #e5e7eb;padding:10px;text-align:left;font-size:14px}
th{background:var(--blue);color:white}
.badge{padding:4px 8px;border-radius:12px;font-size:11px;font-weight:700}
.open{background:#ffebee;color:#c62828}.progress{background:#fff8e1;color:#f57f17}.resolved{background:#e8f5e9;color:#2e7d32}
.kb-item{border-left:4px solid var(--blue2);padding:12px;background:#f8fafc;margin-bottom:12px;border-radius:6px}
.team-member{text-align:center}
.team-member img{width:80px;height:80px;border-radius:50%;background:#e3f2fd;margin-bottom:10px}
.escalation{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;margin:20px 0}
.step{flex:1;min-width:140px;background:white;border:2px solid var(--blue2);border-radius:10px;padding:15px;text-align:center;position:relative}
.step:after{content:'→';position:absolute;right:-15px;top:45%;color:var(--blue2);font-weight:bold}
.step:last-child:after{content:''}
footer{background:var(--dark);color:white;padding:25px 5%;text-align:center;margin-top:30px}
/* Chatbot */
#chatBtn{position:fixed;bottom:20px;right:20px;background:var(--blue2);color:white;width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;cursor:pointer;box-shadow:0 5px 20px rgba(0,0,0,.3);z-index:2000}
#chatBox{position:fixed;bottom:90px;right:20px;width:350px;max-width:90%;background:white;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,.2);display:none;flex-direction:column;z-index:2000;overflow:hidden}
#chatHeader{background:var(--blue);color:white;padding:12px;font-weight:700}
